# Copy this file to .env next to docker-compose.yml, then edit the values.
# docker compose reads .env automatically and interpolates the values into
# docker-compose.yml. Every variable here is optional; the default shown is
# used when the variable is unset or empty.

# Host port that the container is published on. The container itself always
# listens on 8787; this changes only the host side.
REFRAME_HOST_PORT=8787

# Host interface the port is published on. The default 127.0.0.1 keeps it
# reachable only from this host (and a reverse proxy running on it). Set it to
# 0.0.0.0 to expose the port on the LAN so a reverse proxy on another host can
# reach it. Security tradeoff: 0.0.0.0 exposes the port to every device on the
# network, so prefer the on-host proxy path for the public domain.
REFRAME_BIND_ADDRESS=127.0.0.1

# Set to "true" when running behind a TLS-terminating reverse proxy so rate
# limiting sees the real client IP from X-Forwarded-For.
REFRAME_TRUST_PROXY=true

# The exact public origin. State-changing requests from any other Origin are refused.
REFRAME_PUBLIC_ORIGIN=https://journal.example.com

# Optional: choose the one-time setup token instead of reading it from the logs.
# Only consulted before the journal exists; ignored once it has been set up.
# REFRAME_SETUP_TOKEN=change-me

# Lock after this long without activity / regardless of activity.
REFRAME_SESSION_IDLE_MINUTES=30
REFRAME_SESSION_MAX_HOURS=12
