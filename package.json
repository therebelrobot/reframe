{
  "name": "reframe",
  "version": "0.2.2",
  "private": true,
  "description": "Self-hosted, encrypted-at-rest thought record journal. Mobile first.",
  "license": "Unlicense",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:server": "REFRAME_COOKIE_SECURE=false REFRAME_DATA_DIR=./data tsx watch server/main.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs --packages=bundle --banner:js=\"import { createRequire as __reframeCreateRequire } from 'node:module'; const require = __reframeCreateRequire(import.meta.url);\"",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "docker:build": "docker buildx build --platform linux/amd64,linux/arm64 -t ghcr.io/therebelrobot/reframe:latest .",
    "docker:run": "docker run --rm -p 8787:8787 -e REFRAME_COOKIE_SECURE=false -v \"$(pwd)/data:/app/data\" ghcr.io/therebelrobot/reframe:latest",
    "docker:push": "docker buildx build --platform linux/amd64,linux/arm64 -t ghcr.io/therebelrobot/reframe:latest --push .",
    "release:patch": "npm version patch -m 'release: %s' && git push --follow-tags",
    "release:minor": "npm version minor -m 'release: %s' && git push --follow-tags",
    "release:major": "npm version major -m 'release: %s' && git push --follow-tags",
    "release:tags": "git tag --list 'v*' --sort=-v:refname | head -n 10"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
